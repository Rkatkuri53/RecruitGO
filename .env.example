# ========================================================
# RecruitGO - Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# NOTE: Never commit .env to a public repository!
# ========================================================

# Google Gemini AI API Key (Required for AI Boolean Search, Parsing, & Match)
GEMINI_API_KEY=your_gemini_api_key_here

# Product License (Default / Enterprise)
PRODUCT_LICENSE_KEY=RECRUITGO-ENTERPRISE

# Optional: Email / IMAP Scanner for Automatic Resume Ingestion
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_TLS=true
